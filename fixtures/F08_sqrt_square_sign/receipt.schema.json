{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact deterministic receipt for the F8 square-root sign counterexample.",
  "properties": {
    "arithmetic_model": {
      "const": "exact integers"
    },
    "claim": {
      "const": "for every real x, sqrt(x^2) = x"
    },
    "claim_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "command": {
      "const": "python3 fixtures/F08_sqrt_square_sign/verify_counterexample.py build/F08_actual_receipt.json"
    },
    "fixture_id": {
      "const": "F8-SQRT-SQUARE-SIGN"
    },
    "input": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "const": -1
        }
      },
      "required": [
        "x"
      ],
      "type": "object"
    },
    "interpreter": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "const": "CPython"
        },
        "version": {
          "const": "3.12.13"
        }
      },
      "required": [
        "implementation",
        "version"
      ],
      "type": "object"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "sqrt_x_squared": {
          "const": 1
        },
        "x": {
          "const": -1
        }
      },
      "required": [
        "sqrt_x_squared",
        "x"
      ],
      "type": "object"
    },
    "predicate_holds": {
      "const": false
    },
    "receipt_schema": {
      "const": "bsc-deterministic-receipt/2"
    },
    "result": {
      "const": "counterexample_confirmed"
    },
    "schema_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "script_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "working_directory": {
      "const": "repository root"
    }
  },
  "required": [
    "arithmetic_model",
    "claim",
    "claim_sha256",
    "command",
    "fixture_id",
    "input",
    "interpreter",
    "output",
    "predicate_holds",
    "receipt_schema",
    "result",
    "schema_sha256",
    "script_sha256",
    "working_directory"
  ],
  "title": "BSC deterministic fixture receipt",
  "type": "object"
}
