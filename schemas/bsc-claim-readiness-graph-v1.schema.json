{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bsc:schema:claim-readiness-graph:v1",
  "$comment": "Structural validation only. Semantic validation, cap evaluation, and evidence binding require the repository checker and retained receipts.",
  "title": "BSC finite claim-readiness graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "axes", "nodes", "edges"],
  "properties": {
    "schema": {"const": "bsc.claim-readiness-graph.v1"},
    "axes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "applicable_axes", "initial"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
          },
          "verdict": {
            "enum": ["N/A", "false", "ill-posed", "open", "true"]
          },
          "applicable_axes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
            }
          },
          "initial": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "caps"],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
          },
          "caps": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
